# Öffentliche Adresse der App (ohne Slash am Ende). Lokal: Vite-Dev-Server
APP_URL=http://localhost:5173
PORT=8787

# Discogs-App anlegen: https://www.discogs.com/settings/developers → "Create an Application"
# Callback-URL dort: <APP_URL>/api/auth/callback
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Optional statt OAuth (nur für dich allein): persönlicher Token von derselben Seite
DISCOGS_PERSONAL_TOKEN=

# Zufälliger String, mind. 32 Zeichen (z.B. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional: Foto-Erkennung von Platten + Vibe-Tagging (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: BPM + Tonart (kostenlos, https://getsongbpm.com/api)
GETSONGBPM_API_KEY=
