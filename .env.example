# Lokal unter Node: diese Datei als .env kopieren.
# Auf Cloudflare: dieselben Namen unter Pages → Settings → Variables and Secrets eintragen.
# Für `wrangler pages dev`: als .dev.vars kopieren.

# Öffentliche Adresse der App. Auf Cloudflare optional (wird sonst aus der Anfrage genommen).
# Lokal mit `npm run dev`: http://localhost:5173
APP_URL=http://localhost:5173
PORT=8787

# Discogs-App: https://www.discogs.com/settings/developers → "Create an Application"
# Callback-URL dort: <APP_URL>/api/auth/callback
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Zufälliger String, mind. 32 Zeichen (z.B. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional, kostenlos: Vibe-Tags von Last.fm (https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# Optional, kostenlos: BPM + Tonart (https://getsongbpm.com/api)
GETSONGBPM_API_KEY=

# Optional, kostenpflichtig: Claude für die beste Foto-Erkennung und Vibes
ANTHROPIC_API_KEY=
# Wer deinen Claude-Key nutzen darf: Discogs-Namen, kommagetrennt ("*" = alle).
# Alle anderen bekommen die kostenlosen Varianten oder tragen in der App einen eigenen Key ein.
AI_ALLOWLIST=

# Optional statt OAuth (nur Single-User, lokal): persönlicher Discogs-Token
DISCOGS_PERSONAL_TOKEN=
