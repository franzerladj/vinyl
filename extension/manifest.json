{
  "manifest_version": 3,
  "name": "Crate",
  "description": "Crate neben Discogs und jedem Plattenladen: Hast du schon? Steht sie auf der Wantlist? Dein Tempo, deine Tonart, deine Sets.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Crate", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "alarms", "activeTab", "scripting"],
  "host_permissions": ["https://crate-8vf.pages.dev/*", "https://api.discogs.com/*"],
  "content_scripts": [
    { "matches": ["https://www.discogs.com/*"], "js": ["panel.js", "discogs.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [{ "resources": ["fonts/archivo.woff2", "icons/48.png"], "matches": ["<all_urls>"] }]
}
